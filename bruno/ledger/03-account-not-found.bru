meta {
  name: Reject missing account
  type: http
  seq: 3
}

get {
  url: http://localhost:8082/api/v1/accounts/ffffffff-ffff-ffff-ffff-ffffffffffff/entries
  body: none
  auth: none
}

headers {
  Accept: application/problem+json
}

tests {
  test("Returns an account not found problem", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().status).to.equal(404);
    expect(res.getBody().code).to.equal("NOT_FOUND");
    expect(res.getHeader("content-type"))
      .to.include("application/problem+json");
  });
}
